# =============================================================================
# JARVIS Backend — Multi-stage Docker Build
# Python 3.11-slim + system dependencies
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder — install Python deps
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

# Prevent .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# System build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only the dependency manifest first (cache layer)
COPY deployment/docker/requirements.backend.txt ./requirements.txt

# sentence-transformers pulls torch, and recent torch wheels for linux/aarch64
# carry the CUDA runtime (~4 GB of nvidia-* + triton) that is dead weight on a
# CPU-only container. Install the CPU build first so the resolver reuses it.
RUN pip install --upgrade pip setuptools wheel \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: Production image
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS production

# PYTHONPATH: modules are launched as `backend.app.*` but import each other as
# `app.*`, so backend/ must be on the path; /app covers agents/, core/, voice/.
# HF_HOME: sentence-transformers downloads all-MiniLM-L6-v2 here on first use.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app \
    PYTHONPATH=/app:/app/backend \
    HF_HOME=/app/.cache/huggingface

# Runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Audio processing
    ffmpeg \
    portaudio19-dev \
    libsndfile1 \
    # OCR
    tesseract-ocr \
    tesseract-ocr-eng \
    # Database client
    libpq5 \
    # Networking
    curl \
    ca-certificates \
    # Runtime
    libffi8 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Create non-root user
RUN groupadd -r jarvis && useradd -r -g jarvis -d $APP_HOME -s /sbin/nologin jarvis

WORKDIR $APP_HOME

# Copy application source
COPY --chown=jarvis:jarvis . .

# Create required directories (incl. the HF model cache and gunicorn's control
# socket dir, both written at runtime by the non-root user)
RUN mkdir -p uploads logs .cache/huggingface .gunicorn \
    && chown -R jarvis:jarvis uploads logs .cache .gunicorn

# Switch to non-root user
USER jarvis

# Expose application port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -sf http://localhost:8000/health || exit 1

# Worker count comes from WEB_CONCURRENCY (gunicorn reads it natively). Each
# worker imports torch via sentence-transformers, so this is the main lever on
# the container's memory footprint.
ENV WEB_CONCURRENCY=4

# Production server with Uvicorn + Gunicorn
CMD ["gunicorn", \
     "backend.app.main:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]
